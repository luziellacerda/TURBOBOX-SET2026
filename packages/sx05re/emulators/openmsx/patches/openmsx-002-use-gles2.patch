diff --git a/build/platform-linux.mk b/build/platform-linux.mk
index 5d44db3..ce6d0fc 100644
--- a/build/platform-linux.mk
+++ b/build/platform-linux.mk
@@ -14,3 +14,6 @@ LIBRARYEXT:=.so
 ifeq (,$(findstring uclibc,$(CXX)))
 	LINK_FLAGS+=-lrt
 endif
+
+# EmuELEC uses the EGL/OpenGL ES stack instead of desktop OpenGL.
+LINK_FLAGS+=-lGLESv2
